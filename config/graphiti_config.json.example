{
  "schema_version": 1,
  "database": {
    "neo4j_home": "",
    "neo4j_uri": "bolt://127.0.0.1:7687",
    "neo4j_user": "neo4j",
    "neo4j_password": "",
    "neo4j_database": "neo4j",
    "neo4j_http_port": 7474
  },
  "embedding": {
    "enabled": true,
    "mode": "cloud",
    "provider": "sentence_transformers",
    "model_path": "data/models/embedding",
    "dimension": 1024,
    "device": "auto",
    "model": "text-embedding-v4",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key": ""
  },
  "rerank": {
    "enabled": true,
    "mode": "cloud",
    "provider": "sentence_transformers",
    "model_path": "data/models/rerank",
    "device": "auto",
    "model": "qwen3-rerank",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key": "",
    "dimension": null
  },
  "chat": {
    "enabled": true,
    "provider": "openai_compat",
    "base_url": "https://api.deepseek.com",
    "api_key": "",
    "model": "deepseek-v4-flash",
    "temperature": 0.7,
    "max_tokens": 8192,
    "timeout": 60
  },
  "features": {
    "narrative_orchestration_v2_enabled": false
  },
  "logging": {
    "level": "INFO",
    "retention_days": 30
  },
  "memory": {
    "sqlite_path": "data/graphiti/memory.sqlite3",
    "busy_timeout_ms": 10000
  },
  "diary": {
    "enabled": true,
    "memory_extraction": true,
    "key_section": "chat_backup"
  },
  "vector": {
    "collection": "graphiti_memory",
    "dimension": 1024
  },
  "retrieval": {
    "version": "atom-mem-recall-v1",
    "semantic_threshold": 0.25,
    "rerank_enabled": false,
    "direct_rerank_threshold": 0.45,
    "indirect_rerank_threshold": 0.4,
    "relative_floor_ratio": 0.4,
    "direct_top_k": 20,
    "token_budget": 8000,
    "semantic_weight": 0.5,
    "rerank_weight": 0.5,
    "warm_similarity_threshold": 0.35,
    "warm_relative_floor_ratio": 0.55,
    "warm_top_k": 8,
    "chatlog_enabled": false,
    "chatlog_semantic_threshold": 0.15,
    "chatlog_semantic_weight": 0.6,
    "chatlog_recency_weight": 0.4,
    "chatlog_recency_decay": 0.97,
    "chatlog_top_k": 4,
    "chatlog_token_budget": 2000,
    "chatlog_max_entries": 2000,
    "temp_hit_entity_recall": true,
    "temp_hit_entity_top_k": 5,
    "core_search_enabled": false,
    "preview_items_per_entity": 3,
    "hook_exact_admission_enabled": true,
    "hook_exact_min_chars": 2,
    "hook_exact_max_candidates": 3,
    "expansion_enabled": true,
    "expansion_max_candidates": 60,
    "expansion_neighbors_per_seed": 5,
    "expansion_hop_decay": 0.75,
    "expansion_seed_count": 1,
    "expansion_depth_bonus": 0.3,
    "fact_first_enabled": true,
    "entity_anchoring_enabled": true,
    "anchor_facts_per_entity": 6,
    "anchor_seed_limit": 3,
    "entity_fallback_enabled": true,
    "expansion_strategy": "bfs",
    "expansion_max_depth": 3,
    "expansion_facts_per_entity": 6,
    "fact_near_duplicate_ratio": 0.62,
    "hub_penalty_strength": 0.15,
    "chain_ranking_weight": 0.35,
    "chain_gate_enabled": true,
    "chain_semantic_floor": 0.18,
    "compact_prompt_content": true,
    "query_routing_enabled": true,
    "rrf_fusion_enabled": true,
    "rrf_k": 60,
    "activation_enabled": true,
    "activation_rank_bonus": 0.1,
    "activation_edge_weighting": true,
    "activation_weight_floor": 0.25,
    "activation_weight_max": 1.0,
    "activation_initial_weight": 0.5,
    "activation_gain_alpha": 0.4,
    "activation_gain_decay": 0.8,
    "activation_gain_min": 0.04,
    "activation_half_life_hours": 168.0,
    "activation_half_life_growth": 1.2,
    "activation_edge_gain_ratio": 0.5,
    "candidate_multiplier": 4,
    "rerank_batch_size": 50,
    "warm_rag_enabled": true,
    "warm_rag_chunk_tokens": 256,
    "warm_rag_chunk_overlap": 32,
    "warm_rag_dense_top_k": 128,
    "warm_rag_rerank_top_k": 15
  },
  "hot_zone": {
    "hit_window_days": 7,
    "min_hit_rounds": 5,
    "min_batch_hit_rate": 0.3,
    "min_hit_batches": 2,
    "batch_rate_metric": "round",
    "include_events": false,
    "max_age_days": 0,
    "max_items_per_anchor": 2,
    "token_ratio": 0.25,
    "settle_quiet_seconds": 3600
  },
  "reflection": {
    "enabled": true,
    "interval_seconds": 86400,
    "min_idle_seconds": 3600,
    "backoff_seconds": 3600,
    "max_items": 3,
    "max_overlay_tokens": 400,
    "max_overlay_items": 12,
    "key_section": "chat_backup",
    "auto_activate": true
  },
  "chat_backup": {
    "enabled": false,
    "provider": "openai_compat",
    "base_url": "https://api.deepseek.com",
    "api_key": "",
    "model": "deepseek-v4-flash",
    "temperature": 0.7,
    "max_tokens": 4096,
    "timeout": 60
  },
  "extraction_opt": {
    "enabled": true,
    "second_pass": true,
    "dedup_gate": true,
    "dedup_gate_min_similarity": 0.62,
    "schema_limit": 3
  }
}